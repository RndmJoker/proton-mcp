# Proton Mail Bridge credentials
#
# The Bridge password is NOT your Proton account password. The Bridge
# generates one per account. You can find it in the Bridge application under
# the account, or in a terminal via "protonmail-bridge --cli" and then "info".
#
# Never commit this file with real values. Better than a .env inside the
# project is a file outside the repository with mode 600, for example
# ~/.config/proton-mcp/env

BRIDGE_USER=your.address@example.com
BRIDGE_PASS=xxxxxxxxxxxxxxxxxxxxxx

# Address and ports of the Bridge.
#
# The ports are configurable in the Bridge. If you changed them there, either
# set them here or change them in the web interface, which stores them for you.
# Setting them here wins: the interface then shows them as fixed rather than
# quietly overriding what you configured, and offers no form for them.
#
# The host is only settable here, never in the interface. A host field in a web
# form would be a way to send your Bridge password to another machine.
BRIDGE_HOST=127.0.0.1
BRIDGE_IMAP_PORT=1143
BRIDGE_SMTP_PORT=1025

# Mode of operation
# true = no modifying operations at all, not even moving or flagging
PROTON_MCP_READ_ONLY=false

# What the assistant may do, per tool. Optional; the defaults are that every
# sending tool and every filter tool that changes something asks first, and
# every other tool acts on its own. Each list takes tool names or the groups
# reading, filing, writing, sending and filters, separated by commas. A tool named on its own wins over its group. Set here, a level wins
# over the Permissions page of the web interface.
# PROTON_MCP_OFF=trash_messages,send_forward
# PROTON_MCP_ASK_FIRST=send_draft
# PROTON_MCP_ACT_ON_ITS_OWN=send_reply

# Bounds on sending without asking. Each one optional; a send outside a bound
# asks first instead of failing.
# PROTON_MCP_SEND_ALLOWED=boss@example.com,@example.org
# PROTON_MCP_SEND_MAX_PER_HOUR=10
# PROTON_MCP_ACT_UNTIL=2026-12-31

# A copy of every message sent, added before the question is asked. Optional.
# PROTON_MCP_COPY_AS is bcc, the default and a record the recipients do not
# see, or cc, visible to every recipient. Set here, it wins over the web
# interface.
# PROTON_MCP_COPY_TO=archive@example.com
# PROTON_MCP_COPY_AS=bcc

# Local web interface
# Binds to 127.0.0.1 only. There is no remote access. Every running server
# shares the interface at this one port, so set the same value for all of them.
PROTON_MCP_WEB_PORT=7345

# Saving attachments as files (save_attachment)
# Off unless set. An absolute path to a directory that already exists; files go
# there or into a folder inside it and nowhere else, readable by you alone, and
# are deleted an hour after saving and when the server stops. Only settable here,
# never in the web interface.
# PROTON_MCP_ATTACHMENT_DIR=/absolute/path/to/a/directory

# Where the server keeps its own files. All of them are written with mode 600.
# Defaults shown; you normally do not need to set these.
#
#   env                     the credentials file, when you use the plain-file option
#   credentials.enc         the encrypted credentials, when you use that option
#   known-certificate.json  the Bridge certificate, recorded on first use
#   settings.json           what was changed in the web interface: ports, notice
#   saved-attachments/      which files save_attachment wrote, so exactly those are deleted
#
# PROTON_MCP_ENV_FILE=~/.config/proton-mcp/env
# PROTON_MCP_VAULT_FILE=~/.config/proton-mcp/credentials.enc
# PROTON_MCP_CERT_FILE=~/.config/proton-mcp/known-certificate.json
# PROTON_MCP_SETTINGS_FILE=~/.config/proton-mcp/settings.json
